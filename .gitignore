# Environments. Each is a pinned stack for exactly ONE dependency set, rebuilt
# by scripts/, never committed, and they must not reference each other. The
# LIBERO venv pins robosuite 1.4.1 + mujoco 3.1.6 (scripts/setup_libero_venv.sh);
# .venv carries the kinematics tests (tools/emit_trials.py).
.venv/
.venv-*/

# Upstream checkouts. Tens of GB; nothing here belongs in git.
third_party/
!third_party/LIBERO.commit

# THE SCRIPTS THAT REBUILD ENVIRONMENTS AND RESULTS ARE TRACKED, DELIBERATELY.
# A previous `scripts/` was never committed; when the working tree was cleared the
# recipe to rebuild everything went with it.
!scripts/

# Trained policies (tools/token_data.py train, tools/distill.py train). Reproducible
# from scripts/ and the caches below; tens of MB each.
checkpoints/
.cache/
*.safetensors
*.pt
*.ckpt

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Derived data and run outputs: demonstration shards, DAgger rounds, DINOv2 token
# caches (tens of GB), logs, per-episode trial files, rollout videos.
cache/
runs/
videos/
*.jsonl

# component-belief MCP. Tracked: .belief/artifacts/ (run_test outputs). NOT tracked
# yet: the ledger itself (.belief/*.jsonl, 49 MB of evidence) -- the *.jsonl rule
# above excludes it. The derived belief cache is regenerable from evidence +
# declarations.
.belief/cache/

# textbook-index MCP: the concept graph and index are derived from the PDFs in
# docs/ and rebuilt on first tool call.
kuzu_concept_db*

# The textbook is a copyrighted third-party document, not project source. It is
# read through the textbook-index MCP from a local path; docs/*.md reference it
# by section rather than reproducing it.
docs/*.pdf
